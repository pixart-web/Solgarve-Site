---
import Layout from '../layouts/Layout.astro';
---

<Layout
  lang="pt"
  title="Página não encontrada"
  description="Esta página não foi encontrada. Volte a explorar a Solgarve."
  draft
>
  <section class="container section not-found">
    <p class="eyebrow">404 · SOLGARVE</p>
    <h1>
      Este caminho
      <br />
      ficou pelo caminho.
    </h1>
    <p>
      A página que procura não está aqui. Volte ao início para continuar a
      conhecer a Solgarve.
    </p>
    <a class="button" href="/pt/">
      Voltar ao início ↗
    </a>
    <p lang="en">
      This page could not be found.{' '}
      <a class="text-link" href="/en/">
        Explore Solgarve in English ↗
      </a>
    </p>
  </section>
</Layout>

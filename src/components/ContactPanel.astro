---
import { copy, url, site, type Lang } from '../data/site';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="contact-panel">
  <div class="container">
    <p class="eyebrow">SOLGARVE · QUARTEIRA</p>
    <h2>
      {lang === 'pt' ? (
        <>
          Comece por conhecer
          <br />o seu próximo <em>refúgio.</em>
        </>
      ) : (
        <>
          Get to know your
          <br />
          next <em>quiet escape.</em>
        </>
      )}
    </h2>
    <p>
      {lang === 'pt'
        ? 'Tem alguma questão sobre os apartamentos ou a Solgarve? Estamos por aqui.'
        : 'Have a question about the apartments or Solgarve? We are here to help.'}
    </p>
    <div>
      <a class="button" href={url(lang, 'contact')}>
        {copy[lang].contact} <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href={`mailto:${site.email}`}>
        {site.email}
      </a>
    </div>
  </div>
</section>
